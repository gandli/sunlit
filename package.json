{
  "name": "sunlit-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sunlit — React 19 implementation. Cross-branch consistency baseline: see SPEC.md on the `spec` branch.",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:local": "SUNLIT_URL=http://localhost:5173 playwright test --project=chromium"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
